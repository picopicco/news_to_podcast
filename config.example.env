# Copy to .env in the repo root (never commit the real .env).
# Loaded automatically by run_pipeline.py.

INSTAPAPER_CONSUMER_KEY=
INSTAPAPER_CONSUMER_SECRET=
INSTAPAPER_USERNAME=
INSTAPAPER_PASSWORD=

# From https://aistudio.google.com/apikey (free tier, not Cloud Billing).
GEMINI_API_KEY=

# Full JSON key content of the GCP service account (single line), not a
# file path. Used only for Google Cloud Text-to-Speech (Cloud Platform
# scope) -- not for Drive (service accounts have zero Drive storage
# quota and cannot own files).
GOOGLE_SERVICE_ACCOUNT_JSON=

# OAuth client (Desktop app type) + refresh token for the user's own
# Google account, used for all Drive access (upload/list/delete). Files
# are owned by the user, so they count against the user's own Drive
# storage plan. See scripts/oauth_setup.py for how the refresh token is
# generated (one-time, local, interactive).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Folder ID (from the Drive folder's URL) owned by the user.
GOOGLE_DRIVE_FOLDER_ID=

# Optional overrides; defaults are ja-JP-Neural2-B / ja-JP-Neural2-C.
VOICE_A=
VOICE_B=
