# Copy to .env for local testing (never commit the real .env).
# In the cloud routine, these are supplied as environment secrets instead.

INSTAPAPER_CONSUMER_KEY=
INSTAPAPER_CONSUMER_SECRET=
INSTAPAPER_USERNAME=
INSTAPAPER_PASSWORD=

# Full JSON key content of the GCP service account (single line), not a
# file path. Used for both Google Cloud Text-to-Speech and Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Folder ID (from the folder's URL) shared with the service account's
# client_email as Editor.
GOOGLE_DRIVE_FOLDER_ID=

# Optional overrides; defaults are ja-JP-Neural2-B / ja-JP-Neural2-C.
VOICE_A=
VOICE_B=
